# Copier en .env (jamais versionné) et remplir les valeurs.
# Clés publiques uniquement côté client : la clé service_role ne va JAMAIS
# dans l'APK ni dans le panneau web.

# Projet Supabase (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Uniquement pour la CLI Supabase sur le Mac (supabase link / db push)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
