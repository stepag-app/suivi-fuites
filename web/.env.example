# Variables publiques (visibles dans le navigateur : c'est normal et prévu par Supabase).
# À renseigner dans Vercel (Settings > Environment Variables) et dans web/.env.local pour le développement.
# JAMAIS de clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Facultatives (valeurs par défaut : STEPAG, agents.stepag.ma)
NEXT_PUBLIC_NOM_ORGANISATION=
NEXT_PUBLIC_DOMAINE_AGENTS=
