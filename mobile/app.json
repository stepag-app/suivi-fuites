{
  "expo": {
    "name": "Suivi des fuites",
    "slug": "suivi-fuites",
    "scheme": "suivi-fuites",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ma.stepag.suivifuites",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b5d8a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA", "POST_NOTIFICATIONS", "REQUEST_INSTALL_PACKAGES"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "La position sert à localiser les fuites." }],
      ["expo-image-picker", { "cameraPermission": "L'appareil photo sert à photographier les fuites.", "photosPermission": false }],
      ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#0084d1", "defaultChannel": "notifications" }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": false, "buildArchs": ["armeabi-v7a", "arm64-v8a"], "useLegacyPackaging": true } }],
      ["expo-font", { "android": { "fonts": [{
        "fontFamily": "Geist",
        "fontDefinitions": [
          { "path": "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf", "weight": 400 },
          { "path": "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf", "weight": 500 },
          { "path": "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf", "weight": 600 },
          { "path": "./node_modules/@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf", "weight": 700 }
        ]
      }] } }],
      "./plugins/okhttp-delais.js"
    ]
  }
}
