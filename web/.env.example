# Variables publiques (visibles dans le navigateur : c'est normal et prévu par Supabase).
# À renseigner dans Vercel (Settings > Environment Variables) et dans web/.env.local pour le développement.
# JAMAIS de clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Facultatives (valeurs par défaut : STEPAG, agents.stepag.ma)
NEXT_PUBLIC_NOM_ORGANISATION=
NEXT_PUBLIC_DOMAINE_AGENTS=
# Facultative : clé ArcGIS Location Platform pour l'image satellite (restreinte au domaine du panneau) ; vide = pas de satellite
NEXT_PUBLIC_ESRI_CLE=

# Envoi des documents par e-mail (S18) : SERVEUR SEULEMENT, jamais de préfixe NEXT_PUBLIC_.
# Clé Resend posée par Issam dans Vercel (Production) ; vide = bouton présent mais envoi refusé (« non configuré »).
RESEND_API_KEY=
# Facultatives : expéditeur (défaut « STEPAG <contact@stepag.ma> »), copie cachée et réponses (défaut contact@stepag.ma),
# EMAIL_FOURNISSEUR=essai pour les essais locaux (rien ne part).
EMAIL_EXPEDITEUR=
EMAIL_COPIE=
EMAIL_FOURNISSEUR=
