# Variables publiques (intégrées dans l'APK : c'est normal pour la clé « anon / publishable »).
# JAMAIS de clé service_role ici.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Facultative (valeur par défaut : agents.stepag.ma)
EXPO_PUBLIC_DOMAINE_AGENTS=
# Facultative : adresse publique du panneau web, ouvert dans l'écran Balayage (carte du réseau) ; HTTPS seulement.
# Laissée vide, l'application utilise la valeur ci-dessous.
EXPO_PUBLIC_WEB_URL=https://suivi-fuites-web.vercel.app
